<%@ page pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title><c:out value="${screenTitle}" /> | AnpiLink</title>

    <link rel="stylesheet"
          href="${pageContext.request.contextPath}/css/${(showRoster or showGroups) ? 'staff-answers.css?v=20261120' : 'style.css?v=20261015-2'}">
</head>
<body class="a">
    <%-- 遷移先URL --%>
    <c:url var="homeUrl"
           value="/safety/teacher/Home.action" />
    <c:url var="answersUrl" value="/safety/teacher/Home.action">
        <c:param name="view" value="answers" />
    </c:url>
    <c:url var="studentRemoveUrl" value="/safety/teacher/StudentRemove.action" />
    <c:url var="studentAddUrl" value="/safety/teacher/StudentAdd.action" />
    <c:url var="studentProxyRegisterUrl" value="/safety/teacher/StudentProxyRegister.action" />
    <c:url var="groupsUrl" value="/safety/teacher/Home.action">
        <c:param name="view" value="groups" />
    </c:url>
    <c:url var="logoutUrl"
           value="/safety/auth/Logout.action" />
	<c:url var="familyRequestsUrl"
       value="/safety/teacher/FamilyRequests.action" />
    <c:url var="familyRequestDetailUrl"
       value="/safety/teacher/FamilyRequestDetail.action" />
    <c:url var="familyRequestReviewUrl"
       value="/safety/teacher/FamilyRequestReview.action" />
    <c:url var="dangerTypesUrl"
       value="/safety/teacher/DangerTypes.action" />
    <c:url var="dangerTypeAddUrl"
       value="/safety/teacher/DangerTypeAdd.action" />
    <c:url var="dangerTypeDeleteUrl"
       value="/safety/teacher/DangerTypeDelete.action" />
       
    <header class="portal-header">
        <div class="brand">AnpiLink</div>

        <div class="portal-user">
            <span class="user-dot" aria-hidden="true"><c:out value="${fn:substring(sessionScope.user.name, 0, 1)}" /></span>

            <span>
                <c:out value="${sessionScope.user.name}" />先生
            </span>

            <button type="button"
                    class="logout"
                    id="logoutOpen"
                    onclick="openLogoutDialog()">
                ログアウト
            </button>
        </div>
    </header>

    <div class="portal-layout">
        <aside class="portal-nav">
            <span class="nav-caption">職員ポータル</span>

            <a class="nav-item ${(showRoster or showGroups or showFamilyRequests or showDangerTypes) ? '' : 'active'}" href="${homeUrl}" aria-current="${(showRoster or showGroups or showFamilyRequests or showDangerTypes) ? 'false' : 'page'}">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 10 9-7 9 7M5 9v12h14V9M9 21v-7h6v7"/>
              </svg>
              <span>ホーム</span>
            </a>
            <a class="nav-item ${showRoster ? 'active' : ''}" href="${answersUrl}" aria-current="${showRoster ? 'page' : 'false'}">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="m5 12 4 4L19 6"/>
              </svg>
              <span>回答状況</span>
            </a>
            <a class="nav-item ${showGroups ? 'active' : ''}" href="${groupsUrl}" aria-current="${showGroups ? 'page' : 'false'}">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="8" r="3"/>
                <path d="M3 20v-3a6 6 0 0 1 12 0v3M17 5a3 3 0 0 1 0 6M18 14a5 5 0 0 1 3 5"/>
              </svg>
              <span>グループ</span>
            </a>
            <a class="nav-item" role="link" aria-disabled="true">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2"/>
                <path d="m3 7 9 6 9-6"/>
              </svg>
              <span>学校からの連絡</span>
            </a>
            <a class="nav-item ${showFamilyRequests ? 'active' : ''}" href="${familyRequestsUrl}" aria-current="${showFamilyRequests ? 'page' : 'false'}">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="m5 12 4 4L19 6"/>
              </svg>
              <span>保護者の申請</span>
            </a>
            <a class="nav-item ${showDangerTypes ? 'active' : ''}" href="${dangerTypesUrl}" aria-current="${showDangerTypes ? 'page' : 'false'}">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3 10 18H2ZM12 9v5m0 3v.1"/>
              </svg>
              <span>困っている内容</span>
            </a>

            <div class="class-card">
                <span>担当クラス</span>
                <c:if test="${empty assignedClasses}">
                    <strong>担当クラスなし</strong>
                </c:if>
                <c:forEach var="room" items="${assignedClasses}">
                    <strong><c:out value="${room.className}" /></strong>
                    <small>生徒 <c:out value="${room.studentCount}" />人</small>
                </c:forEach>
            </div>

            <footer class="app-footer portal-footer">
                ＠AnpiLink
            </footer>
        </aside>

        <main class="portal-main">
